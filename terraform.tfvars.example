aws_region        = "ap-south-1"
vpc_cidr          = "10.0.0.0/16"
subnet_cidr       = "10.0.1.0/24"
availability_zone = "ap-south-1a"

instance_type    = "m7i-flex.large"
root_volume_size = 20
worker_count     = 1

key_name         = "your-key-pair"
my_ip            = "YOUR_PUBLIC_IP/32"
private_key_path = "/path/to/key.pem"
